{
  "components": {
    "schemas": {
      "CheckName": {
        "enum": [
          "database",
          "migrations",
          "worker",
          "ai_provider"
        ],
        "title": "CheckName",
        "type": "string"
      },
      "CheckStatus": {
        "enum": [
          "ok",
          "failed",
          "disabled"
        ],
        "title": "CheckStatus",
        "type": "string"
      },
      "FieldError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Loc",
            "type": "array"
          },
          "msg": {
            "title": "Msg",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "FieldError",
        "type": "object"
      },
      "LivenessOut": {
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "LivenessOut",
        "type": "object"
      },
      "Problem": {
        "properties": {
          "code": {
            "description": "Stable machine-readable error code.",
            "title": "Code",
            "type": "string"
          },
          "correlation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Correlation Id"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "title": "Errors",
            "type": "array"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "description": "URN identifying the problem type.",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code",
          "correlation_id"
        ],
        "title": "Problem",
        "type": "object"
      },
      "ReadinessCheckOut": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "name": {
            "$ref": "#/components/schemas/CheckName"
          },
          "observed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Time of the evidence the check relies on.",
            "title": "Observed At"
          },
          "status": {
            "$ref": "#/components/schemas/CheckStatus"
          }
        },
        "required": [
          "name",
          "status",
          "detail",
          "observed_at"
        ],
        "title": "ReadinessCheckOut",
        "type": "object"
      },
      "ReadinessOut": {
        "properties": {
          "checked_at": {
            "format": "date-time",
            "title": "Checked At",
            "type": "string"
          },
          "checks": {
            "items": {
              "$ref": "#/components/schemas/ReadinessCheckOut"
            },
            "title": "Checks",
            "type": "array"
          },
          "cycle_interval_s": {
            "title": "Cycle Interval S",
            "type": "number"
          },
          "status": {
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checked_at",
          "cycle_interval_s",
          "checks"
        ],
        "title": "ReadinessOut",
        "type": "object"
      }
    }
  },
  "info": {
    "summary": "Health intelligence for a simulated industrial data platform.",
    "title": "IPHI API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "RFC 9457 problem details."
          }
        },
        "summary": "Liveness: the API process answers.",
        "tags": [
          "system"
        ]
      }
    },
    "/ready": {
      "get": {
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessOut"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "RFC 9457 problem details."
          }
        },
        "summary": "Readiness: database, migrations, worker heartbeat and AI provider status.",
        "tags": [
          "system"
        ]
      }
    }
  }
}
