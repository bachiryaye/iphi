# Copy to .env to override defaults. Never commit .env (rules.md X-01).
# Values below are placeholders for a local, simulated demo only.

# PostgreSQL (compose service "db"; published on 127.0.0.1 only)
IPHI_DB_USER=iphi
IPHI_DB_PASSWORD=change-me-local-only
IPHI_DB_NAME=iphi
IPHI_DB_PORT=5433

# Published ports. Local HTTP sessions require loopback binding (ADR 0025).
IPHI_BIND_HOST=127.0.0.1
# Host header values the API answers (DNS-rebinding guard); add the address you browse to
IPHI_ALLOWED_HOSTS=127.0.0.1,localhost
IPHI_API_PORT=8000
IPHI_FRONTEND_PORT=8080

# Backend
IPHI_LOG_LEVEL=info
# json (default, structured) or console (human-readable, local debugging)
IPHI_LOG_FORMAT=json
# Worker cycle period in seconds (architecture §02.2)
IPHI_CYCLE_INTERVAL_S=5
# Optional diagnosis: none (default), fake (local test), openai or openrouter.
IPHI_LLM_PROVIDER=none
# OpenRouter: use openrouter/free (or an explicit :free variant); paid routes are refused.
# OpenAI: explicitly choose a model supporting structured output. No default paid model.
IPHI_LLM_MODEL=
IPHI_LLM_API_KEY=
# OpenRouter only: default preserves model behavior. Choose an effort supported by the model.
# Example: particle-ai/particle-1:free accepts none; mandatory-reasoning models may reject it.
IPHI_LLM_REASONING_EFFORT=default
IPHI_LLM_TIMEOUT_S=20
# Conservative input cap includes prompt, evidence, schema and message overhead.
IPHI_LLM_INPUT_TOKENS=8192
IPHI_LLM_OUTPUT_TOKENS=1600

# Simulation
# Seed of the deterministic generator; reset falls back to it (ADR 0002)
IPHI_SIM_SEED=42
# Observation retention in platform days (ADR 0008)
IPHI_RETENTION_DAYS=7

# MQTT simulation: make mqtt-up selects the connector through compose.mqtt.yaml.
# The broker is internal, without published ports; real endpoints are not supported.
IPHI_MQTT_TIMEOUT_S=3

# Running the images without Compose (ADR 0020)
# Run the migration before api/worker start; serialized between containers
IPHI_MIGRATE_ON_START=false
# Seconds the migration waits for the database
IPHI_DB_WAIT_S=60
# Worker liveness file and the age beyond which the healthcheck fails
IPHI_LIVENESS_FILE=/tmp/iphi-worker.alive
IPHI_LIVENESS_MAX_AGE_S=300
# Frontend image only: where Nginx proxies /api, /health and /ready
IPHI_API_UPSTREAM=http://api:8000

# Backend tests outside Compose connect to the "db" service through its published port.
IPHI_TEST_DATABASE_URL=postgresql+psycopg://iphi:change-me-local-only@127.0.0.1:5433/postgres

# US-11: server sessions; local permits HTTP cookies on loopback only.
# production enables Secure cookies and requires HTTPS at the ingress.
IPHI_DEPLOYMENT_MODE=local
# Run make init-env to generate local demo passwords; never commit their values.
IPHI_DEMO_VIEWER_PASSWORD=
IPHI_DEMO_ENGINEER_PASSWORD=
IPHI_DEMO_ADMIN_PASSWORD=
