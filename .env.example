# Copy to .env to override defaults. Never commit .env (rules.md X-01).
# Values below are placeholders for a local, simulated demo only.

# PostgreSQL (compose service "db"; published on 127.0.0.1 only)
IPHI_DB_USER=iphi
IPHI_DB_PASSWORD=change-me-local-only
IPHI_DB_NAME=iphi
IPHI_DB_PORT=5433

# Published ports. Any non-loopback IPHI_BIND_HOST disables unauthenticated mutations (ADR 0007).
IPHI_BIND_HOST=127.0.0.1
# Host header values the API answers (DNS-rebinding guard); add the address you browse to
IPHI_ALLOWED_HOSTS=127.0.0.1,localhost
IPHI_API_PORT=8000
IPHI_FRONTEND_PORT=8080

# Backend
IPHI_LOG_LEVEL=info
# json (default, structured) or console (human-readable, local debugging)
IPHI_LOG_FORMAT=json
# Worker cycle period in seconds (architecture §02.2)
IPHI_CYCLE_INTERVAL_S=5
# AI diagnosis provider; only "none" exists until US-08
IPHI_LLM_PROVIDER=none

# Simulation
# Seed of the deterministic generator; reset falls back to it (ADR 0002)
IPHI_SIM_SEED=42
# Scenario/clock mutations without authentication until US-11; local machine only (ADR 0007)
IPHI_DEV_MUTATIONS=true

# Backend tests outside Compose connect to the "db" service through its published port.
IPHI_TEST_DATABASE_URL=postgresql+psycopg://iphi:change-me-local-only@127.0.0.1:5433/postgres
